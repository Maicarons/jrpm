+		size_t begin = sv.find_first_not_of(" \t\r\n");
+		if (begin == std::string_view::npos) continue;
+		size_t end = sv.find_last_not_of(" \t\r\n");
+		std::string uri(sv.substr(begin, end - begin + 1));
+		if (!uri.empty()) mirrors.push_back(std::move(uri));
